# ─── quantphantom environment ─────────────────────────────────────────────
# Copy to .env.local. Every variable is optional: missing keys disable the
# matching feature with a clear UI state instead of crashing.

# Stocks/ETFs (end-of-day, split+dividend adjusted). https://www.tiingo.com
# Free tier ≈ 50 req/h, 1,000 req/day, 500 unique symbols/month (personal use).
TIINGO_API_KEY=

# Supabase (auth + Postgres with RLS). https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Claude API for "Explain". Server-side only. https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional override of the model id used by /api/explain
ANTHROPIC_MODEL=
# Max explanations per user per UTC day
EXPLAIN_DAILY_LIMIT=20

# Optional: public site URL (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Testing only: serve deterministic fixture bars instead of calling providers.
# Never set this in production.
MARKET_DATA_MODE=
